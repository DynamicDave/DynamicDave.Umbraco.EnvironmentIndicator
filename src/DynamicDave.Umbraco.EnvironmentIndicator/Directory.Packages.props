<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Allow floating versions so extensions can align with the host Umbraco project's package versions -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <!--
      Supported Umbraco versions. Restore picks the lowest version in the range, so the package is compiled against
      Umbraco 17.0.0 and only uses APIs that exist in every supported version. Override to compile against another
      version, e.g. dotnet build -p:UmbracoCmsVersion=18.2.1
    -->
    <UmbracoCmsVersion Condition="'$(UmbracoCmsVersion)' == ''">[17.7.1, 19.0.0)</UmbracoCmsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="$(UmbracoCmsVersion)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="$(UmbracoCmsVersion)" />
  </ItemGroup>
</Project>
