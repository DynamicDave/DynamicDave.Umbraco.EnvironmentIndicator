<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>DynamicDave.Umbraco.EnvironmentIndicator</PackageId>
    <Description>Shows a colored environment banner (LOCAL, ACCEPTANCE/STAGING, PRODUCTION) in the Umbraco backoffice so editors always know which environment they are in.</Description>
    <PackageTags>umbraco-marketplace;umbraco;backoffice;environment</PackageTags>
    <Product>DynamicDave.Umbraco.EnvironmentIndicator</Product>
    <Title>DynamicDave.Umbraco.EnvironmentIndicator</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/DynamicDave/DynamicDave.Umbraco.EnvironmentIndicator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DynamicDave/DynamicDave.Umbraco.EnvironmentIndicator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Built against the minimum supported Umbraco version: its transitive advisories are resolved by the
         Umbraco version of the site that installs the package, so only audit direct dependencies here. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>


  <ItemGroup>
    <InternalsVisibleTo Include="DynamicDave.Umbraco.EnvironmentIndicator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Central package management - no versions -->
    <PackageReference Include="Umbraco.Cms.Api.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <PackageReference Include="Umbraco.Cms.Web.Common" />
  </ItemGroup>


  <ItemGroup>
    <!-- Don't include the client folder as part of packaging nuget build -->
    <Content Remove="Client\**" />

    <!-- However make the Umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
    <None Include="Client\public\umbraco-package.json" Pack="false" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <!-- Client build (Vite/Lit). Runs before build so a fresh clone gets the UI.
       Skip with -p:SkipClientBuild=true. Needs Node 22+ and npm on PATH. -->
  <PropertyGroup>
    <ClientDir>$(MSBuildProjectDirectory)\Client</ClientDir>
    <ClientBundle>$(MSBuildProjectDirectory)\wwwroot\App_Plugins\DynamicDaveUmbracoEnvironmentIndicator\dynamic-dave-umbraco-environment-indicator.js</ClientBundle>
  </PropertyGroup>

  <ItemGroup>
    <ClientInput Include="Client\src\**;Client\public\**;Client\package.json;Client\package-lock.json;Client\vite.config.ts;Client\tsconfig.json" />
  </ItemGroup>

  <Target Name="BuildClient" BeforeTargets="BeforeBuild" Condition="'$(SkipClientBuild)' != 'true'" Inputs="@(ClientInput)" Outputs="$(ClientBundle)">
    <Exec Command="npm --version" ContinueOnError="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_NpmExitCode" />
    </Exec>
    <Error Condition="'$(_NpmExitCode)' != '0'" Text="npm was not found on PATH. Install Node.js 22+ (https://nodejs.org) to build the EnvironmentIndicator client, or pass -p:SkipClientBuild=true." />
    <Exec Condition="!Exists('$(ClientDir)\node_modules')" Command="npm ci" WorkingDirectory="$(ClientDir)" />
    <Exec Command="npm run build" WorkingDirectory="$(ClientDir)" />
  </Target>

  <Target Name="EnsureClientBundle" BeforeTargets="Pack;GenerateNuspec">
    <Error Condition="!Exists('$(ClientBundle)')" Text="Client bundle missing ($(ClientBundle)). Build the client first (do not pass -p:SkipClientBuild=true to pack on a clean checkout)." />
  </Target>

</Project>
